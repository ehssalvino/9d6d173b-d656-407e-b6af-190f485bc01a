ões da placa: 140 x 270 mm; \\H1.83909x; \\H0.54375x;\\P-^Icor do fundo: amarela, em epóxi; \\H1.57236x; \\H0.63599x;\\P-^Iletras: cor preta, tinta eletrostática em pó; \\H1.64967x; }", "insert": [297.8765627140508, -7972.116261713914, 0.0], "height": 3.0, "layer": "TXT-02"}, {"text": "270 mm", "insert": [330.1438193483366, -7916.214238127002, 0.0], "height": 2.1, "layer": "TXT-02"}, {"text": "140 mm", "insert": [284.2954073179222, -7928.251909636658, 0.0], "height": 2.1, "layer": "TXT-02"}, {"text": "Geração", "insert": [305.2366122940642, -7942.123700448039, 0.0], "height": 3.824999999999999, "layer": "Texto"}, {"text": "Distribuída", "insert": [303.8351374195976, -7948.910689881894, 0.0], "height": 3.824999999999999, "layer": "Texto"}, {"text": "no Circuito", "insert": [303.8351374195976, -7954.941294111179, 0.0], "height": 3.824999999999999, "layer": "Texto"}, {"text": "250 mm", "insert": [187.403004086102, -7914.378115849117, 0.0], "height": 2.1, "layer": "TXT-02"}, {"text": "180 mm", "insert": [141.5545920556877, -7926.415787358772, 0.0], "height": 2.1, "layer": "TXT-02"}, {"text": "XXXXXXXXXXXXXXXXXXXXXX", "insert": [833.7848879707439, -8026.96810802902, 0.0], "height": 1.746082285060209, "layer": "TEXTO CAR2"}, {"text": "ESTE PROJETO ESTÁ PROTEGIDO POR LEI DE DIREITO AUTORAL, SENDO PROIBIDA SUA REPRODUÇÃO TOTAL OU PARCIAL, SOB AS PENAS DA LEI 9.610 DE FEV/98", "insert": [753.4692149714468, -8040.4089421047, 0.0], "height": 1.746082285049357, "layer": "TEXTO CAR2"}, {"text": "AUTOR DO PROJETO:", "insert": [783.4252683246143, -7983.211169764242, -2.1e-15], "height": 1.269878025490442, "layer": "TEXTO CAR1"}, {"text": "(LOGO)", "insert": [771.7367656970074, -8023.263695326591, 0.0], "height": 3.527438959695672, "layer": "TEXTO CAR2"}, {"text": "ESPAÇO RESERVADO AO LOGO DA EMPRESA (SE HOUVER):", "insert": [752.2174852331018, -8009.04460859041, 0.0], "height": 1.269878025490442, "layer": "TEXTO CAR1"}, {"text": "CONTEÚDO:", "insert": [813.8120334639309, -8009.016